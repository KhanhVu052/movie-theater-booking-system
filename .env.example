# Copy to .env, fill in the values, then load it before starting the backend:
#   set -a; source .env; set +a; cd backend && ./mvnw spring-boot:run
# .env is git-ignored. Never commit real secrets.

# --- Required ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- First admin account (only used when the database has no ADMIN yet) ---
BOOTSTRAP_ADMIN_EMAIL=admin@cinema.com
# At least 8 characters. Choose your own, do not reuse a password from the docs.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Local demo only ---
# true enables the "simulate payment" button/endpoint so you can demo without a public IPN URL.
DEV_TOOLS_ENABLED=false

# --- Optional overrides (defaults match docker-compose.yml) ---
# DB_URL=jdbc:mysql://localhost:3306/cinema_booking_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# DB_USERNAME=root
# DB_PASSWORD=root
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return
