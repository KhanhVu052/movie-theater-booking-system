# Copy to .env, fill in the values, then load it before starting the backend:
#   Linux/macOS: set -a; source .env; set +a; cd backend && ./mvnw spring-boot:run
#   Windows: run-backend.bat (auto-loads this .env file)
# .env is git-ignored. Never commit real secrets.

# --- Required ---
# Generate with: openssl rand -base64 48 (minimum 32 bytes)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# --- First admin account (only used when the database has no ADMIN yet) ---
BOOTSTRAP_ADMIN_EMAIL=admin@cinema.com
# At least 8 characters. Choose your own secure password, do not reuse passwords from documentation.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Local demo only ---
# true enables the "simulate payment" button/endpoint so you can demo without a public IPN URL (FR-DEV-01).
DEV_TOOLS_ENABLED=false

# --- Database configuration (default port: 3306 matching docker-compose.yml) ---
# DB_URL=jdbc:mysql://localhost:3306/cinema_booking_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# DB_USERNAME=root
# DB_PASSWORD=root

# --- Optional overrides (VNPay Sandbox) ---
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
